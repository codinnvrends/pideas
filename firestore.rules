rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Operations: Public read allowed (UUID serves as the secure token)
    match /operations/{operationId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Users: Public read allowed for Leaderboard; Write restricted to owner/admin
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Generated Ideas: Public GET allowed for sharing; List/Write restricted to owner/admin
    match /generated_ideas/{ideaId} {
      allow get: if true;
      allow list: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // Projects History: Allow public GET for sharing; restrictions for list/write
    match /projectHistory/{historyId} {
      allow get: if true;
      allow list: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role == 'admin') ||
        get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // System Prompts (for Admin)
    match /system_prompts/{promptId} {
      allow read: if true; // Or authenticated
      allow write: if isAdmin();
    }
    
    // Logs (Admin only)
    match /logs/{logId} {
        allow read: if isAdmin();
    }

    // System Alerts: Public read, Admin write
    match /system_alerts/{alertId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
