rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read/write their own user role document
    match /userRoles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow admins to read/write all user roles (for admin functions)
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin';
    }
    
    // BYOK: Users can only access their own encrypted API keys
    match /userApiKeys/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Ensure the document ID matches the user ID for security
      allow create: if request.auth != null && 
        request.auth.uid == userId && 
        request.auth.uid == resource.id &&
        request.resource.data.userId == request.auth.uid;
      // Allow updates only if user owns the document
      allow update: if request.auth != null && 
        request.auth.uid == userId && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      // Allow delete only if user owns the document
      allow delete: if request.auth != null && 
        request.auth.uid == userId && 
        resource.data.userId == request.auth.uid;
    }
    
    // Project history - users can read/write their own history
    match /projectHistory/{historyId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    // Admin logs - only admins can read
    match /adminLogs/{logId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin';
      allow write: if false; // Admin logs are written by Cloud Functions only
    }
    
    // Game steps and other collections - authenticated users can read
    match /gameSteps/{stepId} {
      allow read: if request.auth != null;
      allow write: if false; // Read-only for users
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
