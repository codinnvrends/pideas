rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User API Keys collection - highly sensitive data
    match /userApiKeys/{userId} {
      // Only the authenticated user can access their own API key document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Additional validation for write operations
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && resource == null || resource.data.userId == request.auth.uid;
    }
    
    // User history collection
    match /userHistory/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow reading individual history items
      match /ideas/{ideaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Admin logs - only accessible by admin functions
    match /adminLogs/{logId} {
      allow read, write: if false; // Only accessible via server-side functions
    }
    
    // Game steps and other public data
    match /gameSteps/{stepId} {
      allow read: if true; // Public read access
      allow write: if false; // Only server-side writes
    }
    
    // Default deny rule for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
